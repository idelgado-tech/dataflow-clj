{:paths     ["resources" "src"]
 :mvn/repos {"central"   {:url "https://repo1.maven.org/maven2/"}
             "clojars"   {:url "https://repo.clojars.org/"}
             "confluent" {:url "https://packages.confluent.io/maven/"}}
 :deps      {;;-----------------------------------------------------
             ;; Clojure
             ;;-----------------------------------------------------
             org.clojure/clojure                    {:mvn/version "1.12.5"}
             org.clojure/tools.logging              {:mvn/version "1.3.1"}


             ;;-----------------------------------------------------
             ;; google storage API
             ;;-----------------------------------------------------
             com.google.cloud/google-cloud-dataflow {:mvn/version "0.101.0"}}
 :aliases   {:dev  {:extra-deps {vvvvalvalval/scope-capture {:mvn/version "0.3.2"}}}
             :test {:extra-paths ["test"]
                    :extra-deps  {org.clojure/test.check {:mvn/version "1.1.1"}
                                  metosin/testit         {:mvn/version "0.4.0"}
                                  lambdaisland/kaocha    {:mvn/version "0.0-418"}
                                  ring/ring-mock         {:mvn/version "0.4.0"}}}}}

